# ============================================
# X Persona — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# ── App Settings ──────────────────────────────
APP_NAME="X Persona"
APP_URL="http://localhost:8000"
SECRET_KEY="change-me-to-a-random-secret-string"

# ── Admin Authentication ──────────────────────
# Generate a hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=""

# ── X API Configuration ──────────────────────
# Toggle between official API (production) and twikit (dev/testing)
# Set to "twikit" for local dev, "official" for production
X_API_PROVIDER=twikit

# Official X API v2 Bearer Token (required when X_API_PROVIDER=official)
X_API_BEARER_TOKEN=""

# ── Cache Settings ────────────────────────────
# How many days before a cached profile is considered stale
CACHE_TTL_DAYS=7

# ── Rate Limiting ─────────────────────────────
# Max new analyses per hour (cached lookups are unlimited)
RATE_LIMIT_PER_HOUR=10

# ── Database ──────────────────────────────────
# SQLite for dev, PostgreSQL URL for production
# Examples:
#   sqlite+aiosqlite:///./data/xpersona.db
#   postgresql+asyncpg://user:pass@host:5432/xpersona
DATABASE_URL=sqlite+aiosqlite:///./data/xpersona.db
